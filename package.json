{
  "name": "auditflow",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:web": "npm run dev -w @auditflow/web",
    "dev:worker": "npm run dev -w @auditflow/worker",
    "db:generate": "npm run db:generate --workspaces --if-present",
    "db:push": "npm run db:push --workspaces --if-present",
    "db:seed": "npm run db:seed -w @auditflow/web",
    "install:all": "npm install"
  }
}
